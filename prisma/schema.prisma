// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Userr {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) // Track user creation time

  role      Rolee     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String   @db.ObjectId

}

model Rolee {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String   @unique
  description String?
  users Userr[]  // Virtual reference to associated users
}

